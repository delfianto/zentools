pkgbase=zentools
pkgname=('zentools' 'zentools-gui')
pkgver=0.4.1
pkgrel=2
pkgdesc='AMD Ryzen power profiles, telemetry and memory timings'
arch=('x86_64')
url='https://github.com/delfianto/zentools'
license=('MIT')
depends=('glibc' 'libgcc')
options=('!strip' '!debug')
_archive="zentools-v$pkgver-linux-x86_64"
source=("$url/releases/download/arch-v$pkgver-$pkgrel/$_archive.tar.gz")
sha256sums=('a1993df04fcb1187220d7135cda30752f2dadf71b66cc46f433c304255b1632d')

package_zentools() {
    provides=("zentools-bin=$pkgver-$pkgrel")
    conflicts=('zentools-bin')
    replaces=('zentools-bin')
    cd "$srcdir/$_archive"
    install -Dm0755 zentools "$pkgdir/usr/bin/zentools"
    install -Dm0755 zentools-helper "$pkgdir/usr/bin/zentools-helper"
    local alias
    for alias in zen-epp zen-smu zen-mem; do
        ln -s zentools "$pkgdir/usr/bin/$alias"
    done
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_zentools-gui() {
    pkgdesc='Qt desktop application for ZenTools'
    depends=("zentools=$pkgver-$pkgrel" 'glibc' 'libgcc' 'libstdc++' 'qt6-base>=6.12' 'qt6-declarative>=6.12' 'hicolor-icon-theme')
    optdepends=('polkit: authorize elevated hardware access')
    provides=("zentools-gui-bin=$pkgver-$pkgrel")
    conflicts=('zentools-gui-bin')
    replaces=('zentools-gui-bin')
    cd "$srcdir/$_archive"
    install -Dm0755 zentools-gui "$pkgdir/usr/bin/zentools-gui"
    install -Dm0644 zentools.desktop "$pkgdir/usr/share/applications/zentools.desktop"
    install -Dm0644 zentools.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/zentools.svg"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
